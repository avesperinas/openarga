POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=openarga
POSTGRES_USER=openarga
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://openarga:changeme@localhost:5432/openarga
TEST_DATABASE_URL=postgresql+asyncpg://openarga:changeme@localhost:5433/openarga

PUBLIC_URL=http://localhost:8000
OPENARGA_CONTACT_URL=https://github.com/avesperinas/openarga

OPENARGA_LOCALE=en
OPENARGA_TIMEZONE=UTC
OPENARGA_CURRENCY=EUR
OPENARGA_COUNTRY=
OPENARGA_REGION=
OPENARGA_AREA=

# none, fake, anthropic or openai (any OpenAI-compatible endpoint: Ollama, LM Studio, vLLM...).
# Each person can override these in Connections; the key below is only a shared fallback.
OPENARGA_AI_PROVIDER=none
OPENARGA_AI_BASE_URL=
OPENARGA_AI_FAST_MODEL=
OPENARGA_AI_SMART_MODEL=
OPENARGA_AI_MONTHLY_TOKENS=
OPENARGA_AI_KEY=
# web_search for ai.run: a SearXNG instance or a Brave Search key.
OPENARGA_SEARXNG_URL=
OPENARGA_BRAVE_KEY=
CONNECTIONS_MODE=

GIT_SHA=dev
MODULES_PATH=modules
LOG_LEVEL=info

AUTH_ISSUER=http://localhost:8000/auth/realms/arga
AUTH_AUDIENCE=openarga

# Login. The first admin is created on boot when the realm has no user with that name.
OPENARGA_ADMIN_USERNAME=admin
OPENARGA_ADMIN_PASSWORD=
# Optional: Google, or any OpenID Connect provider (its issuer URL, client id and secret).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENARGA_OIDC_ISSUER=
OPENARGA_OIDC_CLIENT_ID=
OPENARGA_OIDC_CLIENT_SECRET=
OPENARGA_OIDC_NAME=

# Demo instance: /login signs in as one of the cast (subject demo-<username>), MCP is read-only.
OPENARGA_DEMO=
OPENARGA_DEMO_PEOPLE=alex,sam

MCP_PUBLIC_URL=http://localhost:8000/mcp
MCP_ALLOWED_SCOPES=training:read,shopping:read

# The stack (docker-compose.yml, generated by scripts/compose.py). Long random values, one each.
KERNEL_DB_PASSWORD=
AUTH_DB_PASSWORD=
MODULE_REGISTRATION_TOKEN=
KC_ADMIN_PASSWORD=
ARGA_WEB_CLIENT_SECRET=
SESSION_SECRET=
# One per enabled module: <MODULE>_DB_PASSWORD.
GOALS_DB_PASSWORD=
HUB_DB_PASSWORD=
INSIGHTS_DB_PASSWORD=
LIBRARY_DB_PASSWORD=
MACROS_DB_PASSWORD=
MONEY_DB_PASSWORD=
NOTEBOOK_DB_PASSWORD=
OUTINGS_DB_PASSWORD=
PLANNER_DB_PASSWORD=
RECIPES_DB_PASSWORD=
SHOPPING_DB_PASSWORD=
STUDY_DB_PASSWORD=
TRAINING_DB_PASSWORD=
TRAVEL_DB_PASSWORD=
VITALS_DB_PASSWORD=
