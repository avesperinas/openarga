POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=openarga
POSTGRES_USER=openarga
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://openarga:changeme@localhost:5432/openarga
TEST_DATABASE_URL=postgresql+asyncpg://openarga:changeme@localhost:5433/openarga

PUBLIC_URL=http://localhost:8000
OPENARGA_CONTACT_URL=https://github.com/avesperinas/openarga

OPENARGA_LOCALE=en
OPENARGA_TIMEZONE=UTC
OPENARGA_CURRENCY=EUR
OPENARGA_COUNTRY=
OPENARGA_REGION=
OPENARGA_AREA=

# none, fake, anthropic or openai (any OpenAI-compatible endpoint: Ollama, LM Studio, vLLM...).
# Each person can override these in Connections; the key below is only a shared fallback.
OPENARGA_AI_PROVIDER=none
OPENARGA_AI_BASE_URL=
OPENARGA_AI_FAST_MODEL=
OPENARGA_AI_SMART_MODEL=
OPENARGA_AI_MONTHLY_TOKENS=
OPENARGA_AI_KEY=
# web_search for ai.run: a SearXNG instance or a Brave Search key.
OPENARGA_SEARXNG_URL=
OPENARGA_BRAVE_KEY=
CONNECTIONS_MODE=

GIT_SHA=dev
MODULES_PATH=modules
LOG_LEVEL=info

AUTH_ISSUER=http://localhost:8000/auth/realms/arga
AUTH_AUDIENCE=openarga

MCP_PUBLIC_URL=http://localhost:8000/mcp
MCP_ALLOWED_SCOPES=training:read,shopping:read
